{
  "version": 1,
  "author": "Lab 1 IoT - Embedded Engineer",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 60, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 180, "left": -130, "attrs": { "color": "green", "label": "Toggle Button (GPIO 18)" } },
    { "type": "wokwi-led", "id": "led", "top": 70, "left": 160, "attrs": { "color": "green", "label": "Smart LED (GPIO 2)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 130, "left": 150, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:18", "btn:1.l", "green", [ "h-20", "v40" ] ],
    [ "btn:2.l", "esp:GND.1", "black", [ "v20", "h40" ] ],
    [ "esp:2", "r1:1", "green", [ "h20", "v20" ] ],
    [ "r1:2", "led:A", "green", [ "v-20" ] ],
    [ "led:C", "esp:GND.2", "black", [ "v40", "h-80" ] ]
  ]
}

