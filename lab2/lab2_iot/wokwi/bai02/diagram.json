{
  "version": 1,
  "author": "Lab 2 IoT - Embedded Engineer",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 160, "left": -120, "attrs": { "color": "green", "label": "Button (GPIO 18)" } },
    { "type": "wokwi-led", "id": "led1", "top": 60, "left": 200, "attrs": { "color": "red", "label": "LED 1 (GPIO 4)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": 190, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led2", "top": 60, "left": 280, "attrs": { "color": "blue", "label": "LED 2 (GPIO 5)" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 120, "left": 270, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:18", "btn:1.l", "green", [ "h-20", "v40" ] ],
    [ "btn:2.l", "esp:GND.1", "black", [ "v20", "h60" ] ],
    [ "esp:4", "r1:1", "red", [ "h20", "v20" ] ],
    [ "r1:2", "led1:A", "red", [ "v-20" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v40", "h-100" ] ],
    [ "esp:5", "r2:1", "blue", [ "h40", "v20" ] ],
    [ "r2:2", "led2:A", "blue", [ "v-20" ] ],
    [ "led2:C", "esp:GND.2", "black", [ "v40", "h-180" ] ]
  ]
}

