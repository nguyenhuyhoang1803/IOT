{
  "version": 1,
  "author": "Lab 2 IoT - Embedded Engineer",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 70, "left": 0, "attrs": {} },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 70,
      "left": 180,
      "attrs": { "temperature": "28", "humidity": "60" }
    },
    {
      "type": "wokwi-text",
      "id": "lbl_note",
      "top": 35,
      "left": 160,
      "attrs": { "text": "DHT11 LAB - simulated with Wokwi DHT22" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "bz1",
      "top": 250,
      "left": 180,
      "attrs": { "mode": "smooth", "label": "Buzzer (GPIO 15)" }
    },
    {
      "type": "wokwi-led",
      "id": "alarm_led",
      "top": 100,
      "left": -130,
      "attrs": { "color": "red", "label": "Alarm LED (GPIO 2)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 170,
      "left": -120,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "dht1:VCC", "esp:3V3", "red", [ "v20", "h-40" ] ],
    [ "dht1:GND", "esp:GND.2", "black", [ "v30", "h-20" ] ],
    [ "dht1:SDA", "esp:23", "blue", [ "v40", "h-10" ] ],
    [ "esp:15", "bz1:2", "purple", [ "h20", "v20" ] ],
    [ "bz1:1", "esp:GND.2", "black", [ "v20", "h-80" ] ],
    [ "esp:2", "r1:1", "red", [ "h-20", "v30" ] ],
    [ "r1:2", "alarm_led:A", "red", [ "v-20" ] ],
    [ "alarm_led:C", "esp:GND.1", "black", [ "v20", "h40" ] ]
  ]
}
