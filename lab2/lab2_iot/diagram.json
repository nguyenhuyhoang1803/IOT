{
  "version": 1,
  "author": "Lab 2 IoT - Embedded Engineer",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 60, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "pwm_led", "top": 70, "left": 180, "attrs": { "color": "white", "label": "PWM LED (GPIO 4)" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 140, "left": 170, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "hb_led", "top": 70, "left": -130, "attrs": { "color": "blue", "label": "Heartbeat LED (GPIO 2)" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 140, "left": -120, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 220, "left": -130, "attrs": { "color": "green", "label": "Brightness Button (GPIO 18)" } }
  ],
  "connections": [
    [ "esp:4", "r1:1", "cyan", [ "h20", "v20" ] ],
    [ "r1:2", "pwm_led:A", "cyan", [ "v-20" ] ],
    [ "pwm_led:C", "esp:GND.2", "black", [ "v40", "h-100" ] ],
    [ "esp:2", "r2:1", "blue", [ "h-20", "v30" ] ],
    [ "r2:2", "hb_led:A", "blue", [ "v-20" ] ],
    [ "hb_led:C", "esp:GND.1", "black", [ "v20", "h40" ] ],
    [ "esp:18", "btn:1.l", "green", [ "h-20", "v40" ] ],
    [ "btn:2.l", "esp:GND.1", "black", [ "v20", "h40" ] ]
  ]
}
